# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/darukaa
MONGODB_DB_NAME=darukaa

# LLM narration layer (rephrases the already-decided reasoning chain into
# natural prose only — never picks facts, never invents connections).
# Optional: if GROQ_API_KEY is blank, the app falls back to the deterministic
# template composed directly from connections.json, and still always replies.
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# Unused placeholder — kept for reference if you ever want to swap providers.
ANTHROPIC_API_KEY=

# Chroma persistence path
CHROMA_PERSIST_DIR=./chroma_store
